{
  "expo": {
    "name": "Engaz",
    "slug": "engaz",
    "scheme": "engaz",
    "version": "1.0.3",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#050506"
        }
      ],
      "expo-router",
      "expo-secure-store",
      ["expo-audio", { "enableBackgroundPlayback": false }],
      "expo-localization",
      "@react-native-vector-icons/ionicons",
      "@react-native-vector-icons/material-design-icons",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2965EC"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Engaz uses your photo library so you can attach images to a bot message.",
          "cameraPermission": "Engaz uses the camera so you can attach photos to a bot message.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "./plugins/with-worklets-headers",
      "./plugins/with-scene-lifecycle"
    ],
    "ios": {
      "bundleIdentifier": "com.engaz.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "icon": "../../packages/ui-tokens/assets/Engaz.icon",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Engaz uses the camera so you can attach photos to a bot message.",
        "NSPhotoLibraryUsageDescription": "Engaz uses your photo library so you can attach images to a bot message.",
        "NSLocalNetworkUsageDescription": "Engaz connects to a self-hosted Engaz server on your local network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.engaz.app",
      "versionCode": 10,
      "softwareKeyboardLayoutMode": "resize",
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundImage": "./assets/icon-background.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "supportsRTL": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
