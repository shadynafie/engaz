---
import Button from "./Button.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import InstallCommand from "./InstallCommand.astro";
import { getHomeCopy } from "../i18n/home";
import {
  DEFAULT_LOCALE,
  LOCALE_HTML_LANG,
  isLocale,
  localeHomePath,
} from "../i18n/locales";
import type { Locale } from "../i18n/locales";
import BaseLayout from "../layouts/BaseLayout.astro";
import { botColors } from "@engaz/ui-tokens";
import "../styles/marketing.css";
import "../styles/stage-hero.css";
import { DOCS_URL, GITHUB_URL, SITE_NAME, SITE_URL } from "../site";

const locale: Locale = isLocale(Astro.currentLocale)
  ? Astro.currentLocale
  : DEFAULT_LOCALE;
const copy = getHomeCopy(locale);
const homeHref = localeHomePath(locale);
const pageUrl = new URL(homeHref, SITE_URL).toString();
const copyLabels = {
  copyLabel: copy.roster.copyCommand,
  copiedLabel: copy.roster.copiedCommand,
  copyFailed: copy.hero.copyFailed,
};
const TEAM_PORTRAITS = ["chief", "designer", "engineer", "accountant"];
const teamAgents = copy.team.roles.map((role, index) => ({
  name: role.title,
  color: botColors[index],
  portrait: `/brand/team-${TEAM_PORTRAITS[index]}-cutout.webp`,
}));

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${SITE_URL}/#website`,
      url: `${SITE_URL}/`,
      name: SITE_NAME,
      description: getHomeCopy(DEFAULT_LOCALE).description,
    },
    {
      "@type": "WebPage",
      url: pageUrl,
      name: copy.title,
      description: copy.description,
      inLanguage: LOCALE_HTML_LANG[locale],
      isPartOf: { "@id": `${SITE_URL}/#website` },
    },
    {
      "@type": "SoftwareApplication",
      name: SITE_NAME,
      description: getHomeCopy(DEFAULT_LOCALE).description,
      applicationCategory: "ProductivityApplication",
      codeRepository: GITHUB_URL,
      license: `${GITHUB_URL}/blob/main/LICENSE`,
    },
  ],
};
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  {structuredData}
  locale={locale}
  skipLabel={copy.skipToContent}
  homeAlternates
  ogImageAlt={copy.ogImageAlt}
>
  <div class="workbench">
    <div class="workbench__opening">
      <div class="container">
        <Header locale={locale} copy={copy.nav} homeHref={homeHref} />
      </div>
    </div>

    <main id="main">
      <section class="stage-hero" data-pointer-stage>
        <div class="stage-hero__scene" aria-hidden="true">
          <div class="stage-hero__floor"></div>
          <div class="stage-hero__glow"></div>
          <div class="stage-hero__rings">
            <span class="stage-hero__ring stage-hero__ring--outer"></span>
            <span class="stage-hero__ring stage-hero__ring--inner"></span>
          </div>

          <div class="stage-hero__grain"></div>
        </div>
          <ul class="stage-hero__orbit" aria-hidden="true">
            {teamAgents.map((agent, index) => (
              <li class="stage-hero__agent" style={`--bot: ${agent.color}; --i: ${index}`}>
                <span class="stage-hero__avatar"><img src={agent.portrait} width="800" height="800" alt="" decoding="async" /></span>
                <span class="stage-hero__agent-name">{agent.name}</span>
              </li>
            ))}
          </ul>

        <div class="container stage-hero__content">
          <h1>{copy.hero.heading}</h1>
          <p class="stage-hero__lead">{copy.hero.lead}</p>
          <div class="stage-hero__face" data-hero-face aria-hidden="true">
            <img src="/brand/engaz-directional-open.webp" width="1440" height="960" alt="" fetchpriority="high" />
            <img class="stage-hero__blink-half" src="/brand/engaz-directional-half.webp" width="1440" height="960" alt="" />
            <img class="stage-hero__blink-closed" src="/brand/engaz-directional-closed.webp" width="1440" height="960" alt="" />
          </div>
          <InstallCommand {...copyLabels} class="stage-hero__command" />
        </div>
      </section>

      <section id="product" class="workbench-product">
        <div class="container">
          <div class="workbench-section-head" data-reveal>
            <h2>{copy.selfHost.heading}</h2>
            <p>{copy.selfHost.copy}</p>
          </div>
          <figure class="workbench-product__proof" data-reveal>
            <div class="workbench-product__screen">
              <img src="/product-workspace.png" width="1360" height="780" alt={copy.selfHost.imageAlt} loading="lazy" />
            </div>
          </figure>
        </div>
      </section>

      <section id="team" class="workbench-team" data-team-scroll>
        <div class="container">
          <div class="workbench-team__intro" data-reveal>
            <h2><span>{copy.team.headingLine1}</span><span>{copy.team.headingLine2}</span></h2>
            <p>{copy.team.copy}</p>
          </div>
        </div>
        <div class="workbench-team__journey" data-team-journey>
          <div class="workbench-team__stage" data-team-stage data-team-step="3" role="img" aria-label={copy.team.copy}>
            <img class="workbench-team__base" src="/brand/engaz-worktable-solo.webp" width="1672" height="941" alt="" loading="lazy" />
            {["designer", "engineer", "accountant"].map((role) => (
              <div class={`workbench-team__teammate workbench-team__teammate--${role}`}>
                <img src="/brand/engaz-worktable-teammates.png" width="1672" height="941" alt="" loading="lazy" />
              </div>
            ))}
          </div>
        </div>
      </section>

      <section id="selfhost" class="workbench-setup">
        <div class="container">
          <div class="workbench-setup__intro" data-reveal>
            <h2>{copy.openSource.heading}</h2>
            <p>{copy.openSource.copy}</p>
          </div>
          <div class="workbench-setup__install" data-reveal>
            <p>{copy.roster.installInstruction}</p>
            <InstallCommand {...copyLabels} class="workbench-setup__command" />
          </div>
          <ol class="workbench-setup__steps">
            {copy.roster.steps.map((step, index) => (
              <li data-reveal>
                <span class="workbench-setup__number">0{index + 1}</span>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </li>
            ))}
          </ol>
          <div class="workbench-setup__finish" data-reveal>
            <div>
              <p>{copy.roster.installRequirements}</p>
              <span>{copy.roster.status}</span>
            </div>
            <Button href={DOCS_URL} external>{copy.roster.installGuide}</Button>
          </div>
        </div>
      </section>
    </main>

    <div class="container">
      <Footer
        locale={locale}
        languagesLabel={copy.footer.languagesLabel}
        navLabel={copy.footer.navLabel}
        homeLabel={copy.nav.home}
        linkLabels={copy.footer.links}
        homeHref={homeHref}
      />
    </div>
  </div>
</BaseLayout>

<script>
  const root = document.querySelector(".workbench");
  if (root) {
    const hero = root.querySelector<HTMLElement>("[data-pointer-stage]");
    let cheer = 0;
    for (const copyButton of root.querySelectorAll<HTMLButtonElement>("[data-copy-install]")) {
      const install = copyButton.closest<HTMLElement>("[data-install]");
      const command = install?.querySelector<HTMLElement>("[data-install-command]")?.textContent?.trim();
      const copyStatus = copyButton.querySelector<HTMLElement>("[data-copy-status]");
      let copyReset = 0;
      copyButton.addEventListener("click", async () => {
        if (!command || !copyStatus) return;
        clearTimeout(copyReset);
        try {
          await navigator.clipboard.writeText(command);
          copyStatus.textContent = copyButton.dataset.copiedLabel ?? "";
          install?.classList.add("is-copied");
          clearTimeout(cheer);
          hero?.classList.add("is-cheering");
          cheer = window.setTimeout(() => hero?.classList.remove("is-cheering"), 1400);
        } catch {
          copyStatus.textContent = copyButton.dataset.copyFailed ?? "";
        }
        copyReset = window.setTimeout(() => {
          copyStatus.textContent = copyButton.dataset.copyLabel ?? "";
          install?.classList.remove("is-copied");
        }, 2200);
      });
    }
    const motion = !window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const team = root.querySelector<HTMLElement>("[data-team-scroll]");
    const journey = team?.querySelector<HTMLElement>("[data-team-journey]");
    const teamStage = team?.querySelector<HTMLElement>("[data-team-stage]");
    if (motion && team && journey && teamStage) {
      const wideScreen = window.matchMedia("(min-width: 721px)");
      let frame = 0;
      const updateTeam = () => {
        const stickyTop = Number.parseFloat(getComputedStyle(teamStage).top) || 0;
        const travel = Math.max(1, journey.offsetHeight - teamStage.offsetHeight);
        const progress = Math.min(1, Math.max(0, (stickyTop - journey.getBoundingClientRect().top) / travel));
        teamStage.dataset.teamStep = String(Math.min(3, Math.floor(progress * 4)));
        frame = 0;
      };
      const queueTeamUpdate = () => {
        if (!wideScreen.matches) return;
        if (!frame) frame = requestAnimationFrame(updateTeam);
      };
      const syncTeamMotion = () => {
        team.classList.toggle("is-scroll-linked", wideScreen.matches);
        if (wideScreen.matches) queueTeamUpdate();
      };
      window.addEventListener("scroll", queueTeamUpdate, { passive: true });
      window.addEventListener("resize", queueTeamUpdate);
      wideScreen.addEventListener("change", syncTeamMotion);
      syncTeamMotion();
    }
    if (motion && "IntersectionObserver" in window) {
      root.classList.add("workbench--motion");
      const reveals = root.querySelectorAll<HTMLElement>("[data-reveal]");
      const observer = new IntersectionObserver((entries, current) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("is-visible");
          current.unobserve(entry.target);
        }
      }, { rootMargin: "0px 0px -8% 0px", threshold: 0.08 });
      reveals.forEach((element) => observer.observe(element));

      if (hero && window.matchMedia("(pointer: fine)").matches) {
        let frame = 0;
        hero.addEventListener("pointermove", (event) => {
          if (frame) return;
          frame = requestAnimationFrame(() => {
            const bounds = hero.getBoundingClientRect();
            hero.style.setProperty("--px", ((event.clientX - bounds.left) / bounds.width - 0.5).toFixed(3));
            hero.style.setProperty("--py", ((event.clientY - bounds.top) / bounds.height - 0.5).toFixed(3));
            frame = 0;
          });
        }, { passive: true });
        hero.addEventListener("pointerleave", () => {
          cancelAnimationFrame(frame);
          frame = 0;
          hero.style.setProperty("--px", "0");
          hero.style.setProperty("--py", "0");
        });
      }
    }
  }
</script>
