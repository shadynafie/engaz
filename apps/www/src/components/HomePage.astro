---
import Button from "./Button.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import { getHomeCopy } from "../i18n/home";
import {
  DEFAULT_LOCALE,
  LOCALE_HTML_LANG,
  isLocale,
  localeHomePath,
} from "../i18n/locales";
import type { Locale } from "../i18n/locales";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/marketing.css";
import { DOCS_URL, GITHUB_URL, SITE_NAME, SITE_URL } from "../site";

const locale: Locale = isLocale(Astro.currentLocale)
  ? Astro.currentLocale
  : DEFAULT_LOCALE;
const copy = getHomeCopy(locale);
const homeHref = localeHomePath(locale);
const pageUrl = new URL(homeHref, SITE_URL).toString();
const teamImages = ["chief", "designer", "engineer", "accountant"];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${SITE_URL}/#website`,
      url: `${SITE_URL}/`,
      name: SITE_NAME,
      description: getHomeCopy(DEFAULT_LOCALE).description,
    },
    {
      "@type": "WebPage",
      url: pageUrl,
      name: copy.title,
      description: copy.description,
      inLanguage: LOCALE_HTML_LANG[locale],
      isPartOf: { "@id": `${SITE_URL}/#website` },
    },
    {
      "@type": "SoftwareApplication",
      name: SITE_NAME,
      description: getHomeCopy(DEFAULT_LOCALE).description,
      applicationCategory: "ProductivityApplication",
      codeRepository: GITHUB_URL,
      license: `${GITHUB_URL}/blob/main/LICENSE`,
    },
  ],
};
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  {structuredData}
  locale={locale}
  skipLabel={copy.skipToContent}
  homeAlternates
  ogImageAlt={copy.ogImageAlt}
>
  <div class="workbench">
    <div class="workbench__opening">
      <div class="container">
        <Header locale={locale} copy={copy.nav} homeHref={homeHref} />
      </div>
    </div>

    <main id="main">
      <section class="workbench-hero" data-pointer-stage>
        <div class="container workbench-hero__inner">
          <div class="workbench-hero__topline">
            <span class="workbench-index">01 / ENGAZ</span>
            <span>{copy.hero.badge} <span aria-hidden="true">·</span> {copy.hero.pill}</span>
          </div>

          <div class="workbench-hero__grid">
            <div class="workbench-hero__copy">
              <h1>{copy.hero.heading}</h1>
              <p>{copy.hero.lead}</p>
              <div class="workbench-actions">
                <Button href={DOCS_URL} external>{copy.hero.getStarted}</Button>
                <a class="workbench-text-link" href={GITHUB_URL} target="_blank" rel="noreferrer">
                  {copy.hero.viewOnGithub}<span aria-hidden="true">↗</span>
                </a>
              </div>
            </div>
            <div class="workbench-hero__mark" aria-hidden="true">
              <img src="/brand/engaz-matte-hero.webp" width="1440" height="960" alt="" fetchpriority="high" />
              <span class="workbench-hero__eyelid workbench-hero__eyelid--left"></span>
              <span class="workbench-hero__eyelid workbench-hero__eyelid--right"></span>
            </div>
          </div>

          <div class="workbench-hero__baseline" aria-hidden="true">
            <span>ENGAZ</span>
            <span>↓</span>
          </div>
        </div>
      </section>

      <section id="team" class="workbench-team">
        <div class="container">
          <div class="workbench-team__intro" data-reveal>
            <p class="workbench-eyebrow">02 / {copy.team.eyebrow}</p>
            <h2>{copy.team.heading}</h2>
            <p>{copy.team.copy}</p>
          </div>
          <div class="workbench-team__stage" data-reveal>
            <span class="workbench-team__signal" aria-hidden="true"></span>
            <ol class="workbench-team__roster" tabindex="0" aria-label={copy.team.example}>
              {copy.team.roles.map((role, index) => (
                <li>
                  <div class="workbench-team__portrait">
                    <img src={`/brand/team-${teamImages[index]}.webp`} width="800" height="800" alt="" loading="lazy" />
                  </div>
                  <div class="workbench-team__label">
                    <span>0{index + 1}</span>
                    <h3>{role.title}</h3>
                    <p>{role.task}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
          <p class="workbench-team__note">{copy.team.example}</p>
        </div>
      </section>

      <section id="product" class="workbench-product">
        <div class="container">
          <div class="workbench-section-head" data-reveal>
            <p class="workbench-eyebrow">03 / {copy.selfHost.eyebrow}</p>
            <h2>{copy.selfHost.heading}</h2>
            <p>{copy.selfHost.copy}</p>
          </div>

          <div class="workbench-product__story">
            <figure class="workbench-product__visual" data-reveal>
              <div class="workbench-product__frame">
                <div class="workbench-product__frame-top" aria-hidden="true">
                  <span>ENGAZ / {copy.selfHost.eyebrow}</span>
                  <span>01—03</span>
                </div>
                <div class="workbench-product__viewport">
                  <img
                    src="/product-workspace.png"
                    width="2880"
                    height="1800"
                    alt={copy.selfHost.screenshotAlt}
                    loading="lazy"
                  />
                </div>
              </div>
              <figcaption>{copy.selfHost.screenshotCaption}</figcaption>
            </figure>

            <div class="workbench-product__chapters">
              {copy.selfHost.features.map((feature, index) => (
                <article class="workbench-product__chapter" data-chapter data-reveal>
                  <span class="workbench-product__number">0{index + 1} / 03</span>
                  <h3>{feature.title}</h3>
                  <p>{feature.body}</p>
                </article>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section id="how-it-works" class="workbench-setup">
        <div class="container">
          <div class="workbench-setup__intro" data-reveal>
            <p class="workbench-eyebrow">04 / {copy.roster.eyebrow}</p>
            <h2>{copy.roster.heading}</h2>
            <p>{copy.roster.copy}</p>
          </div>
          <ol class="workbench-setup__steps">
            {copy.roster.steps.map((step, index) => (
              <li data-reveal>
                <span class="workbench-setup__number">0{index + 1}</span>
                <div>
                  <h3>{step.title}</h3>
                  <p>{step.body}</p>
                </div>
                <span class="workbench-setup__arrow" aria-hidden="true">↗</span>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section id="why-engaz" class="workbench-ownership">
        <div class="container">
          <p class="workbench-eyebrow" data-reveal>05 / {copy.openSource.eyebrow}</p>
          <div class="workbench-ownership__grid">
            <h2 data-reveal>{copy.openSource.heading}</h2>
            <div data-reveal>
              <p>{copy.openSource.copy}</p>
              <ul>
                {copy.openSource.selfHostItems.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </div>
        </div>
      </section>

      <section id="selfhost" class="workbench-final">
        <div class="container workbench-final__inner">
          <p class="workbench-eyebrow" data-reveal>06 / ENGAZ</p>
          <h2 data-reveal>{copy.cta.heading}</h2>
          <p data-reveal>{copy.cta.copy}</p>
          <div class="workbench-actions" data-reveal>
            <Button href={DOCS_URL} external>{copy.cta.getStarted}</Button>
            <a class="workbench-text-link" href={GITHUB_URL} target="_blank" rel="noreferrer">
              {copy.cta.viewOnGithub}<span aria-hidden="true">↗</span>
            </a>
          </div>
          <img class="workbench-final__mark" src="/brand/engaz-icon-dark.webp" width="1080" height="1080" alt="" aria-hidden="true" loading="lazy" />
        </div>
      </section>
    </main>

    <div class="container">
      <Footer
        locale={locale}
        languagesLabel={copy.footer.languagesLabel}
        navLabel={copy.footer.navLabel}
        homeLabel={copy.nav.home}
        linkLabels={copy.footer.links}
        homeHref={homeHref}
      />
    </div>
  </div>
</BaseLayout>

<script>
  const root = document.querySelector(".workbench");
  if (root) {
    const motion = !window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (motion && "IntersectionObserver" in window) {
      root.classList.add("workbench--motion");
      const reveals = root.querySelectorAll<HTMLElement>("[data-reveal]");
      const observer = new IntersectionObserver((entries, current) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("is-visible");
          current.unobserve(entry.target);
        }
      }, { rootMargin: "0px 0px -8% 0px", threshold: 0.08 });
      reveals.forEach((element) => observer.observe(element));

      const chapters = root.querySelectorAll<HTMLElement>("[data-chapter]");
      const chapterObserver = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          chapters.forEach((chapter) => chapter.classList.toggle("is-current", chapter === entry.target));
        }
      }, { rootMargin: "-38% 0px -38% 0px" });
      chapters.forEach((chapter) => chapterObserver.observe(chapter));

      if (window.matchMedia("(pointer: fine)").matches) {
        const stage = root.querySelector<HTMLElement>("[data-pointer-stage]");
        let frame = 0;
        stage?.addEventListener("pointermove", (event) => {
          if (frame) return;
          frame = requestAnimationFrame(() => {
            const bounds = stage.getBoundingClientRect();
            const x = (event.clientX - bounds.left) / bounds.width - 0.5;
            const y = (event.clientY - bounds.top) / bounds.height - 0.5;
            stage.style.setProperty("--pointer-x", String(x * 12) + "px");
            stage.style.setProperty("--pointer-y", String(y * 12) + "px");
            frame = 0;
          });
        }, { passive: true });
        stage?.addEventListener("pointerleave", () => {
          cancelAnimationFrame(frame);
          frame = 0;
          stage.style.setProperty("--pointer-x", "0px");
          stage.style.setProperty("--pointer-y", "0px");
        });
      }
    }
  }
</script>
