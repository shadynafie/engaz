---
import Button from "./Button.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import { getHomeCopy } from "../i18n/home";
import {
  DEFAULT_LOCALE,
  LOCALE_HTML_LANG,
  isLocale,
  localeHomePath,
} from "../i18n/locales";
import type { Locale } from "../i18n/locales";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/marketing.css";
import { DOCS_URL, GITHUB_URL, SITE_NAME, SITE_URL } from "../site";

const locale: Locale = isLocale(Astro.currentLocale)
  ? Astro.currentLocale
  : DEFAULT_LOCALE;
const copy = getHomeCopy(locale);
const homeHref = localeHomePath(locale);
const pageUrl = new URL(homeHref, SITE_URL).toString();

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${SITE_URL}/#website`,
      url: `${SITE_URL}/`,
      name: SITE_NAME,
      description: getHomeCopy(DEFAULT_LOCALE).description,
    },
    {
      "@type": "WebPage",
      url: pageUrl,
      name: copy.title,
      description: copy.description,
      inLanguage: LOCALE_HTML_LANG[locale],
      isPartOf: { "@id": `${SITE_URL}/#website` },
    },
    {
      "@type": "SoftwareApplication",
      name: SITE_NAME,
      description: getHomeCopy(DEFAULT_LOCALE).description,
      applicationCategory: "ProductivityApplication",
      codeRepository: GITHUB_URL,
      license: `${GITHUB_URL}/blob/main/LICENSE`,
    },
  ],
};
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  {structuredData}
  locale={locale}
  skipLabel={copy.skipToContent}
  homeAlternates
  ogImageAlt={copy.ogImageAlt}
>
  <div class="container">
    <Header locale={locale} copy={copy.nav} homeHref={homeHref} />

    <main id="main">
      <section class="hero landing-hero">
        <div class="landing-hero__copy">
          <p class="landing-kicker"><span class="landing-kicker__dot" aria-hidden="true"></span>{copy.hero.badge} <span aria-hidden="true">·</span> {copy.hero.pill}</p>
          <h1>{copy.hero.heading}</h1>
          <p class="lead">{copy.hero.lead}</p>
          <div class="hero__actions">
            <Button href={DOCS_URL} external>{copy.hero.getStarted}</Button>
            <Button href={GITHUB_URL} variant="secondary" external>{copy.hero.viewOnGithub}</Button>
          </div>
        </div>
        <div class="landing-hero__art" aria-hidden="true">
          <img src="/brand/engaz-icon-light.webp" width="1080" height="1080" alt="" />
        </div>
      </section>

      <section id="product" class="section landing-product">
        <div class="section-intro">
          <p class="eyebrow">{copy.selfHost.eyebrow}</p>
          <h2 class="section-heading">{copy.selfHost.heading}</h2>
          <p class="section-copy">{copy.selfHost.copy}</p>
        </div>
        <figure class="landing-screen">
          <div class="landing-screen__viewport">
            <img
              src="/product-workspace.png"
              width="2880"
              height="1800"
              alt={copy.selfHost.screenshotAlt}
              loading="lazy"
            />
          </div>
          <figcaption>{copy.selfHost.screenshotCaption}</figcaption>
        </figure>
        <div class="card-grid-3 landing-features">
          {copy.selfHost.features.map((feature, index) => (
            <article class="feature-card">
              <span class="landing-index" aria-hidden="true">0{index + 1}</span>
              <h3>{feature.title}</h3>
              <p>{feature.body}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="how-it-works" class="section landing-steps">
        <div class="section-intro">
          <p class="eyebrow">{copy.roster.eyebrow}</p>
          <h2 class="section-heading">{copy.roster.heading}</h2>
          <p class="section-copy">{copy.roster.copy}</p>
        </div>
        <ol class="landing-steps__list">
          {copy.roster.steps.map((step, index) => (
            <li>
              <span class="landing-steps__number">0{index + 1}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section id="why-engaz" class="section landing-why">
        <div class="landing-why__heading">
          <p class="eyebrow">{copy.openSource.eyebrow}</p>
          <h2 class="section-heading">{copy.openSource.heading}</h2>
        </div>
        <div class="landing-why__detail">
          <p>{copy.openSource.copy}</p>
          <ul>
            {copy.openSource.selfHostItems.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </section>

      <section id="selfhost" class="landing-final">
        <img src="/brand/engaz-mark.svg" width="72" height="72" alt="" aria-hidden="true" loading="lazy" />
        <h2>{copy.cta.heading}</h2>
        <p>{copy.cta.copy}</p>
        <div class="cta-actions">
          <Button href={DOCS_URL} external>{copy.cta.getStarted}</Button>
          <Button href={GITHUB_URL} variant="secondary" external>{copy.cta.viewOnGithub}</Button>
        </div>
      </section>
    </main>

    <Footer
      locale={locale}
      languagesLabel={copy.footer.languagesLabel}
      navLabel={copy.footer.navLabel}
      homeLabel={copy.nav.home}
      linkLabels={copy.footer.links}
      homeHref={homeHref}
    />
  </div>
</BaseLayout>
