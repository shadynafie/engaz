---
import Button from "./Button.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import { getHomeCopy } from "../i18n/home";
import {
  DEFAULT_LOCALE,
  LOCALE_HTML_LANG,
  isLocale,
  localeHomePath,
} from "../i18n/locales";
import type { Locale } from "../i18n/locales";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/marketing.css";
import { DOCS_URL, GITHUB_URL, SITE_NAME, SITE_URL } from "../site";

const locale: Locale = isLocale(Astro.currentLocale)
  ? Astro.currentLocale
  : DEFAULT_LOCALE;
const copy = getHomeCopy(locale);
const homeHref = localeHomePath(locale);
const pageUrl = new URL(homeHref, SITE_URL).toString();

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${SITE_URL}/#website`,
      url: `${SITE_URL}/`,
      name: SITE_NAME,
      description: getHomeCopy(DEFAULT_LOCALE).description,
    },
    {
      "@type": "WebPage",
      url: pageUrl,
      name: copy.title,
      description: copy.description,
      inLanguage: LOCALE_HTML_LANG[locale],
      isPartOf: { "@id": `${SITE_URL}/#website` },
    },
    {
      "@type": "SoftwareApplication",
      name: SITE_NAME,
      description: getHomeCopy(DEFAULT_LOCALE).description,
      applicationCategory: "ProductivityApplication",
      codeRepository: GITHUB_URL,
      license: `${GITHUB_URL}/blob/main/LICENSE`,
    },
  ],
};
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  {structuredData}
  locale={locale}
  skipLabel={copy.skipToContent}
  homeAlternates
  ogImageAlt={copy.ogImageAlt}
>
  <div class="workbench">
    <div class="workbench__opening">
      <div class="container">
        <Header locale={locale} copy={copy.nav} homeHref={homeHref} />
      </div>
    </div>

    <main id="main">
      <section class="workbench-hero" data-pointer-stage>
        <div class="container workbench-hero__inner">
          <div class="workbench-hero__topline">
            <span class="workbench-index">01 / ENGAZ</span>
            <span>{copy.hero.badge} <span aria-hidden="true">·</span> {copy.hero.pill}</span>
          </div>

          <div class="workbench-hero__grid">
            <div class="workbench-hero__copy">
              <h1>{copy.hero.heading}</h1>
              <p>{copy.hero.lead}</p>
              <div class="workbench-actions">
                <Button href="#product">{copy.hero.getStarted}</Button>
                <a class="workbench-text-link" href={GITHUB_URL} target="_blank" rel="noreferrer">
                  {copy.hero.viewOnGithub}<span aria-hidden="true">↗</span>
                </a>
              </div>
            </div>
            <div class="workbench-hero__mark" aria-hidden="true">
              <div class="workbench-hero__portrait">
                <img src="/brand/engaz-directional-open.webp" width="1440" height="960" alt="" fetchpriority="high" />
                <img class="workbench-hero__blink-half" src="/brand/engaz-directional-half.webp" width="1440" height="960" alt="" />
                <img class="workbench-hero__blink-closed" src="/brand/engaz-directional-closed.webp" width="1440" height="960" alt="" />
              </div>
            </div>
          </div>

          <div class="workbench-hero__baseline" aria-hidden="true">
            <span>ENGAZ</span>
            <span>↓</span>
          </div>
        </div>
      </section>

      <section id="product" class="workbench-product">
        <div class="container">
          <div class="workbench-section-head" data-reveal>
            <p class="workbench-eyebrow">02 / {copy.selfHost.eyebrow}</p>
            <h2>{copy.selfHost.heading}</h2>
            <p>{copy.selfHost.copy}</p>
          </div>
          <figure class="workbench-product__proof" data-reveal>
            <div class="workbench-product__screen">
              <img src="/product-workspace.png" width="1360" height="780" alt={copy.selfHost.imageAlt} loading="lazy" />
            </div>
            <figcaption>{copy.selfHost.example}</figcaption>
          </figure>
        </div>
      </section>

      <section id="team" class="workbench-team" data-team-scroll>
        <div class="container">
          <div class="workbench-team__intro" data-reveal>
            <p class="workbench-eyebrow">03 / {copy.team.eyebrow}</p>
            <h2><span>{copy.team.headingLine1}</span><span>{copy.team.headingLine2}</span></h2>
            <p>{copy.team.copy}</p>
          </div>
        </div>
        <div class="workbench-team__journey" data-team-journey>
          <div class="workbench-team__stage" data-team-stage>
            <div class="workbench-team__panel workbench-team__panel--solo">
              <img src="/brand/engaz-solo-lonely-scene.webp" width="1774" height="887" alt="" loading="lazy" />
              <p class="workbench-team__scene-label"><span>{copy.team.soloLabel}</span>{copy.team.soloCaption}</p>
            </div>
            <div class="workbench-team__panel workbench-team__panel--group">
              <img src="/brand/engaz-group-scene.webp" width="1448" height="1086" alt="" loading="lazy" />
              <p class="workbench-team__scene-label"><span>{copy.team.groupLabel}</span>{copy.team.groupCaption}</p>
            </div>
          </div>
        </div>
        <div class="container workbench-team__footer">
          <span>{copy.team.example}</span>
        </div>
      </section>

      <section id="selfhost" class="workbench-setup">
        <div class="container">
          <div class="workbench-setup__intro" data-reveal>
            <p class="workbench-eyebrow">04 / {copy.nav.selfHost}</p>
            <h2>{copy.openSource.heading}</h2>
            <p>{copy.openSource.copy}</p>
          </div>
          <ol class="workbench-setup__steps">
            {copy.roster.steps.map((step, index) => (
              <li data-reveal>
                <span class="workbench-setup__number">0{index + 1}</span>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </li>
            ))}
          </ol>
          <div class="workbench-setup__finish" data-reveal>
            <div>
              <p>{copy.roster.installRequirements}</p>
              <span>{copy.roster.status}</span>
            </div>
            <Button href={DOCS_URL} external>{copy.roster.installGuide}</Button>
          </div>
        </div>
      </section>
    </main>

    <div class="container">
      <Footer
        locale={locale}
        languagesLabel={copy.footer.languagesLabel}
        navLabel={copy.footer.navLabel}
        homeLabel={copy.nav.home}
        linkLabels={copy.footer.links}
        homeHref={homeHref}
      />
    </div>
  </div>
</BaseLayout>

<script>
  const root = document.querySelector(".workbench");
  if (root) {
    const motion = !window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const team = root.querySelector<HTMLElement>("[data-team-scroll]");
    const journey = team?.querySelector<HTMLElement>("[data-team-journey]");
    const teamStage = team?.querySelector<HTMLElement>("[data-team-stage]");
    if (motion && team && journey && teamStage) {
      const wideScreen = window.matchMedia("(min-width: 721px)");
      let frame = 0;
      const updateTeam = () => {
        const stickyTop = Number.parseFloat(getComputedStyle(teamStage).top) || 0;
        const travel = Math.max(1, journey.offsetHeight - teamStage.offsetHeight);
        const progress = Math.min(1, Math.max(0, (stickyTop - journey.getBoundingClientRect().top) / travel));
        teamStage.style.setProperty("--team-clip", `${(1 - progress) * 103 - 3}%`);
        frame = 0;
      };
      const queueTeamUpdate = () => {
        if (!wideScreen.matches) return;
        if (!frame) frame = requestAnimationFrame(updateTeam);
      };
      const syncTeamMotion = () => {
        team.classList.toggle("is-scroll-linked", wideScreen.matches);
        if (wideScreen.matches) queueTeamUpdate();
      };
      window.addEventListener("scroll", queueTeamUpdate, { passive: true });
      window.addEventListener("resize", queueTeamUpdate);
      wideScreen.addEventListener("change", syncTeamMotion);
      syncTeamMotion();
    }
    if (motion && "IntersectionObserver" in window) {
      root.classList.add("workbench--motion");
      const reveals = root.querySelectorAll<HTMLElement>("[data-reveal]");
      const observer = new IntersectionObserver((entries, current) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("is-visible");
          current.unobserve(entry.target);
        }
      }, { rootMargin: "0px 0px -8% 0px", threshold: 0.08 });
      reveals.forEach((element) => observer.observe(element));

      if (window.matchMedia("(pointer: fine)").matches) {
        const stage = root.querySelector<HTMLElement>("[data-pointer-stage]");
        let frame = 0;
        stage?.addEventListener("pointermove", (event) => {
          if (frame) return;
          frame = requestAnimationFrame(() => {
            const bounds = stage.getBoundingClientRect();
            const x = (event.clientX - bounds.left) / bounds.width - 0.5;
            const y = (event.clientY - bounds.top) / bounds.height - 0.5;
            stage.style.setProperty("--pointer-x", String(x * 12) + "px");
            stage.style.setProperty("--pointer-y", String(y * 12) + "px");
            frame = 0;
          });
        }, { passive: true });
        stage?.addEventListener("pointerleave", () => {
          cancelAnimationFrame(frame);
          frame = 0;
          stage.style.setProperty("--pointer-x", "0px");
          stage.style.setProperty("--pointer-y", "0px");
        });
      }
    }
  }
</script>
