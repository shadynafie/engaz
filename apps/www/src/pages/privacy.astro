---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { fetchGithubStars, formatStarCount } from "../github";
import BaseLayout from "../layouts/BaseLayout.astro";
import { GITHUB_URL } from "../site";

const stars = await fetchGithubStars();
const starsLabel = stars === null ? "Star" : formatStarCount(stars);
---

<BaseLayout title="Privacy · Engaz" description="How data flows in a self-hosted Engaz installation.">
  <div class="container">
    <Header starsLabel={starsLabel} />
    <main id="main" class="privacy-copy">
      <h1>Privacy</h1>
      <p>Engaz does not currently offer a hosted service. This page describes the open-source software, not a privacy policy for an installation run by someone else.</p>
      <p>A self-hosted operator controls its server, accounts, database, files, backups, and provider connections. AI models and connected services may receive content when the operator enables them and users run tasks. Their own terms and retention policies apply.</p>
      <p>Contact the operator of the server you use for account or data requests. For questions about this project, use <a href={`${GITHUB_URL}/issues`}>GitHub Issues</a> without sharing private data.</p>
    </main>
    <Footer />
  </div>
</BaseLayout>
