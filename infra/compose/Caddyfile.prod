(deploy_retry) {
	lb_try_duration 10s
	lb_try_interval 250ms
}

{$ENGAZ_HOST:app.example.com} {
	encode zstd gzip

	handle /health {
		reverse_proxy api:7792 {
			import deploy_retry
		}
	}

	handle /api/* {
		reverse_proxy api:7792 {
			import deploy_retry
		}
	}

	handle /rpc/* {
		reverse_proxy api:7792 {
			import deploy_retry
		}
	}

	handle {
		reverse_proxy web:7791 {
			import deploy_retry
		}
	}
}
